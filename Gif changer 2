<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GIFフレーム抽出・ダウンローダー</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- omggif for robust client-side GIF parsing -->
    <script src="https://cdn.jsdelivr.net/npm/omggif@1.0.10/omggif.min.js"></script>
    <!-- JSZip and FileSaver for batch downloads -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col items-center p-4 sm:p-8">

    <main class="w-full max-w-4xl bg-white rounded-2xl shadow-xl p-6 sm:p-10 border border-slate-100">
        
        <header class="text-center mb-8">
            <h1 class="text-2xl sm:text-3xl font-bold text-indigo-600 mb-2">GIFフレーム抽出・ダウンローダー</h1>
            <p class="text-slate-500 text-sm sm:text-base">アニメーションGIFをアップロードすると、全フレームを個別にプレビュー＆保存、またはまとめてZIPダウンロードできます。</p>
        </header>

        <!-- Drag & Drop Upload Zone -->
        <div id="dropZone" class="border-2 border-dashed border-indigo-200 hover:border-indigo-500 bg-indigo-50/30 hover:bg-indigo-50/60 rounded-xl p-8 sm:p-12 text-center cursor-pointer transition-all duration-200 mb-8 group">
            <svg class="mx-auto h-12 w-12 text-indigo-400 group-hover:text-indigo-600 mb-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <p class="text-slate-700 font-medium mb-1">ここにGIFファイルをドラッグ＆ドロップ</p>
            <p class="text-slate-400 text-sm mb-4">または、クリックしてファイルを選択</p>
            <button type="button" class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-medium text-sm shadow-sm hover:bg-indigo-700 transition">ファイルを選択</button>
            <input type="file" id="fileInput" accept="image/gif" class="hidden">
        </div>

        <!-- Loading Indicator -->
        <div id="loading" class="hidden text-center py-12">
            <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-indigo-600 border-t-transparent mb-4"></div>
            <p class="text-indigo-600 font-medium" id="loadingText">GIFを解析中...</p>
        </div>

        <!-- Action Panel & Results Header -->
        <div id="actionArea" class="hidden flex flex-col sm:flex-row justify-between items-center bg-slate-100 p-4 rounded-xl mb-6 gap-4">
            <div>
                <span id="frameCountText" class="font-semibold text-slate-700 text-lg">0フレーム検出</span>
            </div>
            <button id="downloadAllBtn" class="w-full sm:w-auto px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg shadow-md transition flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                すべての画像をZIPで一括ダウンロード
            </button>
        </div>

        <!-- Frame Grid List -->
        <div id="resultGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 max-h-[550px] overflow-y-auto p-2"></div>

    </main>

    <!-- Custom Modal for Notifications instead of alert() -->
    <div id="messageModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center">
            <h3 id="modalTitle" class="text-lg font-bold text-slate-800 mb-2">お知らせ</h3>
            <p id="modalMessage" class="text-slate-600 text-sm mb-6"></p>
            <button onclick="closeModal()" class="w-full py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition">閉じる</button>
        </div>
    </div>

    <!-- JavaScript Implementation -->
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const loading = document.getElementById('loading');
        const loadingText = document.getElementById('loadingText');
        const resultGrid = document.getElementById('resultGrid');
        const actionArea = document.getElementById('actionArea');
        const frameCountText = document.getElementById('frameCountText');
        const downloadAllBtn = document.getElementById('downloadAllBtn');
        
        let extractedFrames = [];

        // UI message helper (No alert() used)
        function showMessage(title, msg) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalMessage').textContent = msg;
            document.getElementById('messageModal').classList.remove('hidden');
            document.getElementById('messageModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('messageModal').classList.remove('flex');
            document.getElementById('messageModal').classList.add('hidden');
        }

        // File Selection Events
        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-indigo-600', 'bg-indigo-50/80');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-indigo-600', 'bg-indigo-50/80');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-indigo-600', 'bg-indigo-50/80');
            if (e.dataTransfer.files.length > 0) {
                handleFile(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFile(e.target.files[0]);
            }
        });

        async function handleFile(file) {
            if (file.type !== 'image/gif') {
                showMessage('エラー', '有効なGIFファイルを選択してください。');
                return;
            }

            // Reset view state
            resultGrid.innerHTML = '';
            extractedFrames = [];
            actionArea.classList.add('hidden');
            loading.classList.remove('hidden');
            loadingText.textContent = 'GIFファイルを読み込んでいます...';

            try {
                const arrayBuffer = await file.arrayBuffer();
                const uint8Array = new Uint8Array(arrayBuffer);
                
                loadingText.textContent = '全フレームを解析・抽出中...';
                
                // Parse with omggif
                const reader = new GifReader(uint8Array);
                const width = reader.width;
                const height = reader.height;
                const numFrames = reader.numFrames();

                if (numFrames <= 0) {
                    throw new Error('有効なフレームが見つかりませんでした。');
                }

                // Create persistent canvas for compositing frames
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                
                // ImageData buffer for frame pixels
                const frameBuffer = new Uint8ClampedArray(width * height * 4);

                for (let i = 0; i < numFrames; i++) {
                    // Decode frame onto pixel buffer
                    reader.decodeAndBlitFrameRGBA(i, frameBuffer);
                    const imgData = new ImageData(frameBuffer, width, height);
                    
                    ctx.putImageData(imgData, 0, 0);
                    const dataUrl = canvas.toDataURL('image/png');
                    const fileName = `frame_${String(i + 1).padStart(3, '0')}.png`;

                    extractedFrames.push({
                        dataUrl: dataUrl,
                        name: fileName
                    });

                    // Create Frame Card Preview
                    const card = document.createElement('div');
                    card.className = 'bg-white border border-slate-200 rounded-xl p-3 flex flex-col items-center justify-between shadow-sm hover:shadow-md transition';
                    card.innerHTML = `
                        <div class="w-full h-32 bg-slate-100 rounded-lg flex items-center justify-center mb-3 overflow-hidden border border-slate-100">
                            <img src="${dataUrl}" alt="Frame ${i + 1}" class="max-h-full max-w-full object-contain">
                        </div>
                        <div class="w-full flex items-center justify-between mb-2">
                            <span class="text-xs font-semibold text-slate-600">No. ${i + 1}</span>
                        </div>
                        <button onclick="downloadSingle('${dataUrl}', '${fileName}')" class="w-full py-1.5 px-3 bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-600 font-medium text-xs rounded-lg transition flex items-center justify-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                            </svg>
                            保存
                        </button>
                    `;
                    resultGrid.appendChild(card);
                }

                loading.classList.add('hidden');
                frameCountText.textContent = `${numFrames}個のフレームが抽出されました`;
                actionArea.classList.remove('hidden');

            } catch (error) {
                console.error(error);
                loading.classList.add('hidden');
                showMessage('解析エラー', 'GIFの解析に失敗しました。ファイルが破損しているか、対応していない形式の可能性があります。');
            }
        }

        // Single Image Download Helper
        function downloadSingle(dataUrl, filename) {
            const a = document.createElement('a');
            a.href = dataUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Batch ZIP Download Event Listener
        downloadAllBtn.addEventListener('click', async () => {
            if (extractedFrames.length === 0) return;

            downloadAllBtn.disabled = true;
            downloadAllBtn.innerHTML = `
                <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent mr-2"></div>
                ZIPファイル作成中...
            `;

            try {
                const zip = new JSZip();
                const folder = zip.folder("gif_extracted_frames");

                extractedFrames.forEach(frame => {
                    const base64Data = frame.dataUrl.replace(/^data:image\/png;base64,/, "");
                    folder.file(frame.name, base64Data, { base64: true });
                });

                const content = await zip.generateAsync({ type: "blob" });
                saveAs(content, "gif_frames.zip");
            } catch (err) {
                console.error(err);
                showMessage('エラー', 'ZIPファイルの生成中にエラーが発生しました。');
            } finally {
                downloadAllBtn.disabled = false;
                downloadAllBtn.innerHTML = `
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    すべての画像をZIPで一括ダウンロード
                `;
            }
        });
    </script>
</body>
</html>
